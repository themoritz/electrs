@host = http://127.0.0.1:1337

### Create user

# @prompt password
POST {{host}}/api/user/create
Content-Type: application/json

{
    "email": "mdrexl2@fastmail.fm",
    "password": "{{password}}"
}

### Login

# @name login
# @prompt password
POST {{host}}/api/user/login
Content-Type: application/json

{
    "email": "mdrexl2@fastmail.fm",
    "password": "{{password}}"
}

###

@session = {{login.response.body.session_id}}
@user = {{login.response.body.user_id}}

### Logout

POST {{host}}/api/user/logout
Session: {{session}}

### Create project

POST {{host}}/api/project/create
Session: {{session}}
Content-Type: application/json

{
    "name": "Test project",
    "data": {
        "foo": "bar"
    },
    "is_public": false
}

### Get project

GET {{host}}/api/project/7
Session: {{session}}

### Get public project

GET {{host}}/api/project/public/3

### Get Tx

@txid = 5bae7f1667e28d8148de300473db49229fac4d26abe7425293d1931afd5ed915

GET {{host}}/api/tx/{{txid}}
X-Request-Signature: a1b2c3d4e5f6
X-Forwarded-For: 127.0.0.1

### List user's projects

GET {{host}}/api/projects
Session: {{session}}

### Delete project

DELETE {{host}}/api/project/8
Session: {{session}}

### Set project public

POST {{host}}/api/project/7/public
Session: {{session}}
Content-Type: application/json

true

### Save project

POST {{host}}/api/project/7/data
Session: {{session}}
Content-Type: application/json

{"annotations":{"coin_color":{},"coin_label":{},"tx_color":{},"tx_label":{}},"transactions":[{"position":{"x":740,"y":412},"txid":"196052f851ca34d0b2fe76adeea4712f9ae391d0540af36c97020f2da7c948c7"},{"position":{"x":788,"y":296},"txid":"2eb5907778df2c3701c066f4f5b6ad868c9caf20d9bba9ae7aec91cdb702e122"},{"position":{"x":735,"y":184},"txid":"9d0737b66b74f674547589b73575353b037cd82bade4608dfeb2dc8d0ee476ae"},{"position":{"x":610,"y":283},"txid":"ff90bfa21d9f9d2f47a3ae0fcb434d1d108399020e5e2e8b6ed239ecf019d174"},{"position":{"x":704,"y":71},"txid":"421aaa9af20e1a393d23ac255e34a24b463daa6bf99117de1ae137c86c6327bd"}],"version":0}

### Rename project

POST {{host}}/api/project/7/name
Session: {{session}}
Content-Type: application/json

"Kartoffel"
